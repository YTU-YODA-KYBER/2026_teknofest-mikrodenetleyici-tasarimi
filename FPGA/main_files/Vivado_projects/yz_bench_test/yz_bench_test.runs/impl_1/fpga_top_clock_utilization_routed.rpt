# Location of BUFG Primitives 
set_property LOC BUFGCTRL_X0Y17 [get_cells clk_wizard_inst/inst/clkf_buf]
set_property LOC BUFGCTRL_X0Y16 [get_cells clk_wizard_inst/inst/clkout1_buf]

# Location of IO Primitives which is load of clock spine

# Location of clock ports
set_property LOC IOB_X1Y126 [get_ports sys_clk]

# Clock net "clk_wizard_inst/inst/clk_out1" driven by instance "clk_wizard_inst/inst/clkout1_buf" located at site "BUFGCTRL_X0Y16"
#startgroup
create_pblock {CLKAG_clk_wizard_inst/inst/clk_out1}
add_cells_to_pblock [get_pblocks  {CLKAG_clk_wizard_inst/inst/clk_out1}] [get_cells -filter { PRIMITIVE_GROUP != I/O && IS_PRIMITIVE==1 && PRIMITIVE_LEVEL !=INTERNAL } -of_object [get_pins -filter {DIRECTION==IN} -of_objects [get_nets -hierarchical -filter {PARENT=="clk_wizard_inst/inst/clk_out1"}]]]
resize_pblock [get_pblocks {CLKAG_clk_wizard_inst/inst/clk_out1}] -add {CLOCKREGION_X0Y1:CLOCKREGION_X0Y1 CLOCKREGION_X0Y2:CLOCKREGION_X0Y2 CLOCKREGION_X0Y3:CLOCKREGION_X0Y3 CLOCKREGION_X1Y1:CLOCKREGION_X1Y1 CLOCKREGION_X1Y2:CLOCKREGION_X1Y2 CLOCKREGION_X1Y3:CLOCKREGION_X1Y3}
#endgroup
