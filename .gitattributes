# ---------------------------------------------------------------------------
#  Git LFS izleme kurallari
#
#  GitHub dosya basina 100 MB'i REDDEDER (50 MB'de uyarir). Final Cikti
#  dokumani Tablo 8 ise asic/results/ ve asic/reports/ altindaki bu dosyalari
#  depoda ZORUNLU tutuyor. Cozum: buyuk ciktilar Git LFS ile, sikistirilmadan
#  ve gercek adlariyla saklanir; `git clone` sonrasi juri dosyayi dogrudan acar.
#
#  LFS icerik-adreslidir: ayni icerige sahip iki dosya (orn. top_module.gds ve
#  top_module.klayout.gds) tek nesne olarak saklanir, ikinci kez yer kaplamaz.
# ---------------------------------------------------------------------------

# --- Ikili EDA formatlari (depoda baska yerde kaynak olarak gecmiyor) -------
*.gds   filter=lfs diff=lfs merge=lfs -text
*.def   filter=lfs diff=lfs merge=lfs -text
*.odb   filter=lfs diff=lfs merge=lfs -text
*.mag   filter=lfs diff=lfs merge=lfs -text
*.spef  filter=lfs diff=lfs merge=lfs -text
*.sdf   filter=lfs diff=lfs merge=lfs -text
*.spice filter=lfs diff=lfs merge=lfs -text

# --- Uzantisi kaynak dosyalarla cakisanlar: yol ile sinirlandirilmis --------
# RTL .v dosyalari NORMAL git'te kalir; yalnizca uretilmis netlistler LFS'e.
asic/results/netlist/*.v          filter=lfs diff=lfs merge=lfs -text

# 9 kose STA ham loglari (~74 MB/adet) ve setup/hold yol raporlari
asic/reports/timing/**/*.log      filter=lfs diff=lfs merge=lfs -text
asic/reports/timing/**/max.rpt    filter=lfs diff=lfs merge=lfs -text
asic/reports/timing/**/min.rpt    filter=lfs diff=lfs merge=lfs -text

# Guc analizi net dokumleri (~70 MB/adet)
asic/reports/power/net-*.csv      filter=lfs diff=lfs merge=lfs -text

# Deney arsivindeki buyuk arac loglari
asic/reports/synthesis/deney_arsivi/**/*.log filter=lfs diff=lfs merge=lfs -text
